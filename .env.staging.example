NODE_ENV=staging
PORT=3000
APP_URL=https://staging.example.com

MONGODB_URI=mongodb://staging-mongodb-host:27017/api_staging

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=staging@example.com
MAIL_PASSWORD=replace-with-staging-smtp-password

JWT_SECRET=replace-with-staging-random-secret
JWT_EXPIRATION=3600

REDIS_HOST=staging-redis-host
REDIS_PORT=6379
